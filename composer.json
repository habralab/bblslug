{
  "name": "habr/bblslug",
  "description": "CLI and PHP library for translating plain text, HTML, and JSON with translation APIs.",
  "keywords": ["translation","LLM","deepl","openai"],
  "homepage": "https://github.com/habralab/bblslug",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Vadim Rybalko",
      "email": "vadim@habr.team",
      "role": "Lead"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "symfony/yaml": "^6.4.50 || ^7.4.23 || ^8.1.11"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0.4",
    "phpunit/phpunit": "^11.5.58 || ^12.5.44 || ^13.4.7",
    "phpstan/phpstan": "^2.3.6"
  },
  "autoload": {
    "psr-4": {
      "Bblslug\\": "src/Bblslug/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bblslug\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/bblslug"
  ],
  "scripts": {
    "test:phplint": "vendor/bin/phpcs --standard=phpcs.xml",
    "test:phpunit": "vendor/bin/phpunit --testdox --colors=always --log-junit .phpunit.junit.xml",
    "test:phpstan": "vendor/bin/phpstan analyse src --level=max --memory-limit=-1",
    "lint": "@test:phplint",
    "phpunit": "@test:phpunit"
  }
}
